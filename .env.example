# .env.example - Template for environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to git - it contains secrets!
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# SMTP Email Configuration (for OTP verification)
# ══════════════════════════════════════════════════════════════════════════════

# SMTP server hostname
# Examples:
#   Gmail: smtp.gmail.com
#   Outlook: smtp-mail.outlook.com
#   Yahoo: smtp.mail.yahoo.com
SMTP_HOST=smtp.gmail.com

# SMTP server port
# Common values:
#   587 (TLS - recommended)
#   465 (SSL)
#   25 (unencrypted - not recommended)
SMTP_PORT=587

# SMTP username (usually your email address)
SMTP_USER=your-email@gmail.com

# SMTP password
# ⚠️ IMPORTANT: For Gmail, use an "App Password", NOT your regular password
# Generate one at: https://myaccount.google.com/apppasswords
# For Outlook, enable "Allow less secure apps" or use app-specific password
SMTP_PASSWORD=your-app-specific-password-here

# ══════════════════════════════════════════════════════════════════════════════
# Model API Keys (existing configuration)
# ══════════════════════════════════════════════════════════════════════════════

# Google Gemini API key (for gemini-3-flash, gemini-3-pro)
GOOGLE_API_KEY=

# NVIDIA API key (for Nemotron models)
NVIDIA_API_KEY=

# NVIDIA NIM endpoint + model (both required for NVIDIA to be detected as available)
# Find them at https://build.nvidia.com → your model → View code
# NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ══════════════════════════════════════════════════════════════════════════════
# Local Models (Ollama)
# ══════════════════════════════════════════════════════════════════════════════

# OLLAMA_BASE_URL=http://localhost:11434

# Explicit deployment registry for the A2 adapters/inventory. Copy the example
# to config/deployments.local.json and configure endpoints, models and geography.
# Credential fields in JSON contain environment-variable NAMES, never key values.
# CARBON_DEPLOYMENTS_FILE=config/deployments.local.json

# ══════════════════════════════════════════════════════════════════════════════
# Optional: Demo/Development Settings
# ══════════════════════════════════════════════════════════════════════════════

# Enable replay mode (skip real API calls, use cached data)
# DEMO_REPLAY=1

# Show the login OTP on screen instead of emailing it (no SMTP needed)
OTP_DEV_MODE=true

# Optional dashboard queue override; useful for isolated app/browser rehearsals.
# CARBON_QUEUE_DATABASE=.runtime/queue.sqlite3
